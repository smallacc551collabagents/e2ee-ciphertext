{
  "name": "@e2ee/crypto",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-side E2EE. Audited library only; no invented crypto.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "test": "vitest run"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6",
    "vitest": "^2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}

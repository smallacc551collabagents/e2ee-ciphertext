{
  "name": "e2ee-chat",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "clean": "pnpm -r --if-present clean && rm -rf .vercel",
    "build:clean": "pnpm run clean && pnpm run build",
    "migrate:deploy": "pnpm --filter @e2ee/backend migrate:deploy",
    "migrate:status": "pnpm --filter @e2ee/backend migrate:status",
    "deploy:backend": "vercel pull --yes --environment=production && vercel build --prod && vercel deploy --prebuilt --prod"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0",
    "@types/node": "^20.16.0"
  }
}

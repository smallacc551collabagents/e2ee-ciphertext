# Server-only: backend API origin. The browser never calls it directly; it goes through the
# /api/[...path] route handler (first-party cookie). Middleware and RSC call it server-side.
BACKEND_URL=https://e2ee-ciphertext-backend.vercel.app

# Server-only shared secret injected as x-proxy-secret on every backend call (E2EE-68).
# Must match the backend's PROXY_SHARED_SECRET. Generate with: openssl rand -base64 32
# Required in production: the /api proxy fails closed (500) if unset.
PROXY_SHARED_SECRET=

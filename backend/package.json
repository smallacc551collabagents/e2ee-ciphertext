{
  "name": "@e2ee/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "vercel-build": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "clean": "rm -rf dist .vercel tsconfig.tsbuildinfo",
    "build:clean": "pnpm run clean && pnpm run prisma:generate && pnpm run build",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@e2ee/shared": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^5.20.0",
    "fastify": "^5.0.0",
    "pg": "^8",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20"
  }
}

// Identity layer (users, sessions, reset tokens) + Phase 1 transport layer.
// The server stores ONLY public key material and opaque ciphertext, each as raw
// bytes plus an integer `version`; their internal format is owned by packages/crypto.
// Never add plaintext message bodies or private/session/file keys here.
// Migrations must be strictly additive (prod auto-migrates on merge to main).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(uuid()) @db.Uuid
  /// Stored normalized (lowercase); unique => case-insensitive uniqueness.
  username     String               @unique
  passwordHash String               @map("password_hash")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  identityKey  IdentityKey?
  oneTimeKeys  OneTimePrekey[]
  memberships  ConversationMember[]
  sentMessages Message[]
  deliveries   MessageDelivery[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// SHA-256 of the opaque bearer token; raw token never stored.
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Public identity key + current signed prekey (one row per user; Phase 1 = single device).
model IdentityKey {
  userId                String   @id @map("user_id") @db.Uuid
  identityKey           Bytes    @map("identity_key")
  identityKeyVersion    Int      @map("identity_key_version")
  signedPrekeyId        Int      @map("signed_prekey_id")
  signedPrekey          Bytes    @map("signed_prekey")
  signedPrekeySignature Bytes    @map("signed_prekey_signature")
  signedPrekeyVersion   Int      @map("signed_prekey_version")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identity_keys")
}

/// Pool of PUBLIC one-time prekeys; each handed out at most once (consumed_at set atomically).
model OneTimePrekey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  keyId      Int       @map("key_id")
  publicKey  Bytes     @map("public_key")
  version    Int
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Uniqueness of (user_id, key_id) is a PARTIAL index WHERE consumed_at IS NULL (raw SQL
  // migration 20261024150000_otk_partial_unique); Prisma can't express partial indexes.
  @@index([userId, consumedAt])
  @@map("one_time_prekeys")
}

model Conversation {
  id        String               @id @default(uuid()) @db.Uuid
  /// "direct" now; "group" is a later extension (membership table is already N-ary).
  kind      String               @default("direct")
  /// For direct chats: "<lowUserId>:<highUserId>" — makes create idempotent. NULL for groups.
  directKey String?              @unique @map("direct_key")
  /// Last allocated per-conversation message sequence number.
  lastSeq   BigInt               @default(0) @map("last_seq")
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  members   ConversationMember[]
  messages  Message[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

/// Opaque ciphertext envelope only — never plaintext.
model Message {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  senderId       String            @map("sender_id") @db.Uuid
  seq            BigInt
  /// Client-generated id; (conversation, sender, client_msg_id) unique => idempotent retries.
  clientMsgId    String            @map("client_msg_id")
  ciphertext     Bytes
  version        Int
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  deliveries     MessageDelivery[]

  @@unique([conversationId, seq])
  @@unique([conversationId, senderId, clientMsgId])
  @@map("messages")
}

model MessageDelivery {
  messageId   String    @map("message_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([messageId, recipientId])
  @@index([recipientId, deliveredAt])
  @@map("message_deliveries")
}
